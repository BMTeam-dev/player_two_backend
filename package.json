{
  "name": "player-2-backend",
  "private": true,
  "type": "module",
  "description": "Regras, índices, Cloud Functions e scripts do Firebase do MyNoobPro (codinome Player 2)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm --prefix functions install",
    "build": "npm --prefix functions run build",
    "typecheck": "tsc --noEmit && npm --prefix functions run typecheck",

    "emulators": "npm run build && firebase emulators:start --import=./.emulator-data --export-on-exit",
    "emulators:fresh": "npm run build && firebase emulators:start",
    "dev:bootstrap": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/bootstrap.ts",
    "dev:seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx scripts/seed-dev.ts",
    "dev:rebuild-cards": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/rebuild-search-cards.ts",

    "test": "firebase emulators:exec --project demo-mynoobpro --only firestore \"vitest run\"",

    "db:deploy": "firebase deploy --only firestore:rules,firestore:indexes,database,storage",
    "db:bootstrap": "tsx scripts/bootstrap.ts --prod",
    "db:rebuild-cards": "tsx scripts/rebuild-search-cards.ts --prod",
    "functions:deploy": "firebase deploy --only functions"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
